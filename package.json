{
  "name": "ovi-git",
  "displayName": "Ovi Git",
  "description": "Visualiza el historial de Git como un gráfico y gestiona ramas, commits, etiquetas y stashes.",
  "version": "0.2.1",
  "publisher": "ovi-dev",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovi-dev/ovi-git.git"
  },
  "homepage": "https://github.com/ovi-dev/ovi-git#readme",
  "bugs": {
    "url": "https://github.com/ovi-dev/ovi-git/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "branches"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oviGit.open",
        "title": "Abrir gráfico",
        "category": "Ovi Git",
        "icon": "$(git-merge)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oviGit",
          "title": "Ovi Git",
          "icon": "media/ovi-git.svg"
        }
      ]
    },
    "views": {
      "oviGit": [
        {
          "type": "webview",
          "id": "oviGit.workspace",
          "name": "Workspace",
          "contextualTitle": "Ovi Git"
        }
      ]
    },
    "menus": {
      "scm/title": [
        {
          "command": "oviGit.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "oviGit.open",
          "group": "navigation",
          "when": "view == oviGit.workspace"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
